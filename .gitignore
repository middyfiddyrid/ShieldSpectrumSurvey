# runtime artifacts — sweep data and client reports are SENSITIVE, never commit
data/
reports/
logs/
cache/
capture_images/
case_files/
recordings/
__pycache__/
*.pyc
# live config holds API keys / credentials — keep it LOCAL, never commit secrets.
# Schema lives in survey/config.py DEFAULTS; the app runs on defaults if absent.
config.yaml
# deploy/staging copy of marketing/dcs_explainer.html (near-duplicate, drifts) — keep source only
marketing/netlify_build/
# Claude Code session/editor state — local only
.claude/
config.yaml.*
# Bundled embedded Python interpreter (~120 MB, 3200+ files). It is a
# redistributable, not source — INSTALL (run once).bat provisions it on the
# target machine. Committing it would bloat every clone for no benefit.
runtime/
